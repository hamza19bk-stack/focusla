---
/**
 * Footer.astro — pied de page : coordonnées, réseaux, navigation secondaire, mentions.
 * Aucune prop. Toutes les données viennent de src/data/site.ts.
 * Inclus automatiquement par Base.astro — ne l'ajoute pas dans une page.
 *
 * Règle d'affichage : une valeur vide OU commençant par « TODO_ » (ex. TODO_VILLE)
 * n'est jamais rendue. Les réseaux sociaux vides ne produisent aucun lien.
 */
import { site } from '../data/site';

/* Année calculée au build (site statique : la valeur est figée à la génération). */
const annee = new Date().getFullYear();

const affichable = (valeur: string) => valeur.trim() !== '' && !valeur.trim().startsWith('TODO_');

const ville = affichable(site.contact.city) ? site.contact.city : '';
const lieu = ville ? `${ville}, ${site.contact.country}` : site.contact.country;

/* Icônes SVG inline (24x24, currentColor) — aucune dépendance externe. */
const icones: Record<string, string> = {
  instagram:
    '<path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 1.8.25 2.2.41.6.22 1 .48 1.4.9.4.4.7.8.9 1.4.16.4.35 1 .4 2.2.07 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.05 1.2-.24 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.16-1 .35-2.2.41-1.3.07-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-1.8-.25-2.2-.41-.6-.22-1-.48-1.4-.9-.4-.4-.7-.8-.9-1.4-.16-.4-.35-1-.41-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.25-1.8.41-2.2.22-.6.48-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.16 1-.35 2.2-.41C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.14 0-3.5.01-4.74.07-.9.04-1.4.2-1.72.32-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.13.32-.28.82-.32 1.72C3.41 8.9 3.4 9.26 3.4 12s.01 3.1.07 4.34c.04.9.2 1.4.32 1.72.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.13.82.28 1.72.32 1.24.06 1.6.07 4.74.07s3.5-.01 4.74-.07c.9-.04 1.4-.2 1.72-.32.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.13-.32.28-.82.32-1.72.06-1.24.07-1.6.07-4.34s-.01-3.1-.07-4.34c-.04-.9-.2-1.4-.32-1.72a2.9 2.9 0 0 0-.69-1.06 2.9 2.9 0 0 0-1.06-.69c-.32-.13-.82-.28-1.72-.32C15.5 4.01 15.14 4 12 4Zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 1.8a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Zm5.1-.4a1.15 1.15 0 1 1 0-2.3 1.15 1.15 0 0 1 0 2.3Z"/>',
  facebook:
    '<path d="M14.1 21.9v-8.2h2.8l.42-3.2h-3.22V8.4c0-.93.26-1.56 1.6-1.56h1.72V4a23 23 0 0 0-2.5-.13c-2.48 0-4.18 1.51-4.18 4.3v2.38H7.9v3.2h2.84v8.15h3.36Z"/>',
  tiktok:
    '<path d="M16.6 2h-3.1v13.2a2.5 2.5 0 1 1-2.1-2.47V9.6a5.7 5.7 0 1 0 5.2 5.67V8.8a6.6 6.6 0 0 0 3.9 1.27V6.96a3.55 3.55 0 0 1-2.5-1.14A3.9 3.9 0 0 1 16.6 2Z"/>',
  youtube:
    '<path d="M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.27 5 12 5 12 5s-6.27 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.73 19 12 19 12 19s6.27 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10.1 15V9l5.2 3-5.2 3Z"/>',
  whatsapp:
    '<path d="M12.04 2A9.9 9.9 0 0 0 2.1 11.9c0 1.75.46 3.46 1.34 4.97L2 22l5.27-1.38a9.86 9.86 0 0 0 4.77 1.22h.01a9.9 9.9 0 0 0 9.94-9.9A9.9 9.9 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.2 8.2 0 0 1-1.26-4.36 8.24 8.24 0 1 1 8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23a7.4 7.4 0 0 1-1.37-1.7c-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.13-.14.17-.25.25-.41.09-.17.05-.31-.02-.43-.06-.12-.55-1.34-.76-1.83-.2-.48-.4-.42-.55-.43h-.48c-.16 0-.43.06-.65.31-.23.25-.86.84-.86 2.05s.88 2.38 1 2.54c.13.17 1.74 2.65 4.21 3.71.59.26 1.05.41 1.4.52.6.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.15-1.18-.06-.11-.23-.17-.48-.29Z"/>',
};

/* Uniquement les réseaux réellement renseignés. */
const reseaux = (
  [
    { cle: 'instagram', label: 'Instagram', url: site.social.instagram },
    { cle: 'facebook', label: 'Facebook', url: site.social.facebook },
    { cle: 'tiktok', label: 'TikTok', url: site.social.tiktok },
    { cle: 'youtube', label: 'YouTube', url: site.social.youtube },
    { cle: 'whatsapp', label: 'WhatsApp', url: site.social.whatsapp },
  ] as const
).filter((reseau) => reseau.url.trim() !== '');
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__top">
      <!-- Marque -->
      <div class="footer__brand">
        <a class="footer__logo" href="/">
          <span class="footer__logo-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation" focusable="false">
              <path d="M14 2 5 13.4h4.6L8.6 22 19 10.2h-5.2L14 2Z"></path>
            </svg>
          </span>
          {site.brand.name}
        </a>
        <p class="footer__tagline">{site.brand.tagline}</p>
        <p class="footer__desc">{site.brand.shortDescription}</p>

        {
          reseaux.length > 0 && (
            <ul class="footer__social" aria-label="Réseaux sociaux">
              {reseaux.map((reseau) => (
                <li>
                  <a
                    href={reseau.url}
                    class="footer__social-link"
                    target="_blank"
                    rel="noopener noreferrer me"
                  >
                    <span class="sr-only">{`${reseau.label} (nouvelle fenêtre)`}</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icones[reseau.cle]} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <!-- Navigation secondaire -->
      <nav class="footer__col" aria-label="Navigation du pied de page">
        <h2 class="footer__title">Navigation</h2>
        <ul class="footer__list">
          {
            site.nav.map((lien) => (
              <li>
                <a class="footer__link" href={lien.href}>
                  {lien.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact -->
      <div class="footer__col">
        <h2 class="footer__title">Contact</h2>
        <ul class="footer__list">
          <li>
            <a class="footer__link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
          <li>
            <a class="footer__link" href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a>
          </li>
          <li class="footer__meta">{lieu}</li>
        </ul>

        <ul class="footer__modes" aria-label="Modalités d'accompagnement">
          {site.contact.modes.map((mode) => <li class="chip">{mode}</li>)}
        </ul>

        <a class="btn btn--ghost btn--sm footer__cta" href="/reservation">
          {site.booking.ctaLabel}
        </a>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__legal">
        © {annee} {site.brand.name} — Tous droits réservés.
      </p>
      <p class="footer__legal footer__legal--muted">
        Coaching sportif&nbsp;: les conseils délivrés ne remplacent pas un avis médical. En cas de
        doute, consulte un professionnel de santé avant de reprendre une activité physique.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-3xl);
    padding-block: var(--space-2xl) var(--space-l);
    background: var(--c-bg-deep);
    border-top: 1px solid var(--c-border);
    background-image: radial-gradient(48rem 24rem at 85% 0%, rgba(198, 242, 78, 0.07), transparent 60%);
  }

  .footer__top {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }
  @media (min-width: 48em) {
    .footer__top { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 62em) {
    .footer__top {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }

  .footer__brand { display: flex; flex-direction: column; gap: var(--space-xs); }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: flex-start;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-text);
    line-height: 1;
  }
  .footer__logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    color: var(--c-text-on-accent);
    background: var(--c-accent);
    border-radius: var(--radius-s);
  }
  .footer__logo-mark svg { width: 1.1rem; height: 1.1rem; }

  .footer__tagline {
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--c-accent);
  }
  .footer__desc {
    max-width: 38ch;
    font-size: var(--step--1);
    color: var(--c-text-muted);
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
    list-style: none;
    padding: 0;
  }
  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--c-text-soft);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-s);
    transition: color var(--transition), border-color var(--transition), transform var(--transition);
  }
  .footer__social-link svg { width: 1.25rem; height: 1.25rem; }
  .footer__social-link:hover {
    color: var(--c-accent);
    border-color: var(--c-accent);
    transform: translateY(-2px);
  }

  .footer__col { display: flex; flex-direction: column; gap: var(--space-xs); }

  .footer__title {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .footer__list { display: grid; gap: var(--space-3xs); list-style: none; margin: 0; padding: 0; }

  .footer__link {
    display: inline-block;
    padding-block: 0.35rem;
    font-size: var(--step-0);
    text-decoration: none;
    color: var(--c-text-soft);
    transition: color var(--transition);
    overflow-wrap: anywhere;
  }
  .footer__link:hover { color: var(--c-accent); text-decoration: underline; text-underline-offset: 0.2em; }

  .footer__meta { padding-block: 0.35rem; color: var(--c-text-muted); font-size: var(--step--1); }

  .footer__modes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-top: var(--space-2xs);
    list-style: none;
    padding: 0;
    font-size: var(--step--2);
  }

  .footer__cta { align-self: flex-start; margin-top: var(--space-2xs); }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--c-border);
  }
  .footer__legal { font-size: var(--step--1); color: var(--c-text-soft); }
  .footer__legal--muted { max-width: 72ch; color: var(--c-text-muted); font-size: var(--step--2); }

  @media (prefers-reduced-motion: reduce) {
    .footer__social-link:hover { transform: none; }
  }
</style>
